generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model StaffRole {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  createdAt    DateTime       @default(now())
  staffProfile StaffProfile[]

  @@index([name])
}

model State {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  staffProfiles StaffProfile[]

  @@index([name])
}

model StaffProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  staffId   String    @unique
  roleId    String
  stateId   String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  role      StaffRole @relation(fields: [roleId], references: [id])
  state     State     @relation(fields: [stateId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([roleId])
  @@index([stateId])
}

model StaffIdSequence {
  id        String @id @default(uuid())
  company   String
  roleCode  String
  stateCode String
  lastValue Int    @default(0)

  @@unique([company, roleCode, stateCode])
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  fullName             String
  phoneNumber          String?
  password             String
  isActive             Boolean              @default(true)
  mustChangePassword   Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  role                 AuthRole             @default(USER)
  tokenVersion         Int                  @default(1)
  fundRequestsApproved FundRequest[]        @relation("FundRequestApprovedBy")
  fundRequestsRejected FundRequest[]        @relation("FundRequestRejectedBy")
  fundRequestsCreated  FundRequest[]        @relation("FundRequestRequestedBy")
  fundRequestHistory   FundRequestHistory[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken?
  refreshSessions      RefreshSession[]
  staffProfiles        StaffProfile?

  @@index([fullName])
  @@index([email])
  @@index([role])
}

model RefreshSession {
  id                   String    @id @default(uuid())
  userId               String
  refreshToken         String
  deviceId             String
  userAgent            String
  ipAddress            String
  createdAt            DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  previousRefreshToken String?
  rotatedAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([deviceId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  duid        String
  projectName String?
  projectCode String?
  prNumber    String?
  poNumber    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  poLines     PurchaseOrderLine[]

  @@unique([duid, poNumber])
  @@index([duid])
  @@index([poNumber])
  @@index([projectName])
  @@index([projectCode])
}

model PurchaseOrderLine {
  id                    String               @id @default(uuid())
  purchaseOrderId       String
  poLineNumber          String?
  itemCode              String?
  itemDescription       String?
  poTypeId              String?
  unitPrice             Decimal?             @db.Decimal(15, 2)
  requestedQuantity     Int?
  poLineAmount          Decimal?             @db.Decimal(15, 2)
  contractAmount        Decimal?             @db.Decimal(15, 2)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  poLineStatus          PoLineStatus         @default(NOT_INVOICED)
  remainingBalance      Decimal              @default(0) @db.Decimal(15, 2)
  totalApprovedAmount   Decimal              @default(0) @db.Decimal(15, 2)
  agingFlag             PoAgingFlag          @default(GREEN)
  allowedOpenDays       Int?
  lastAgingNotifiedFlag PoAgingFlag?
  poInvoiceDate         DateTime?
  pm                    String?
  poIssuedDate          DateTime?
  pmId                  String?
  totalRejectedAmount   Decimal              @default(0) @db.Decimal(15, 2)
  totalRequestedAmount  Decimal              @default(0) @db.Decimal(15, 2)
  version               Int                  @default(0)
  ContractAmendments    ContractAmendment[]
  FundRequests          FundRequest[]
  fundRequestHistory    FundRequestHistory[]
  poType                PoType?              @relation(fields: [poTypeId], references: [id])
  purchaseOrder         PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, poLineNumber])
  @@index([purchaseOrderId])
  @@index([poLineNumber])
  @@index([itemCode])
  @@index([unitPrice])
  @@index([requestedQuantity])
  @@index([poLineAmount])
  @@index([poTypeId])
  @@index([poLineStatus])
  @@index([pm])
  @@index([pmId])
  @@index([poIssuedDate])
  @@index([poLineStatus, allowedOpenDays])
}

model PoType {
  id             String              @id @default(uuid())
  code           String              @unique
  name           String
  description    String?
  isActive       Boolean             @default(true)  
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  purchaseOrders PurchaseOrderLine[]

  @@index([name, code])
}

model PoImportHistory {
  id          String   @id @default(uuid())
  fileName    String
  duidCount   Int
  poCount     Int
  poLineCount Int
  status      String
  errors      Json?
  createdBy   String?
  createdAt   DateTime @default(now())
  fileHash    String   @unique

  @@index([status])
  @@index([createdAt])
  @@index([fileHash])
}

model FundRequest {
  id                  String               @id @default(uuid())
  purchaseOrderLineId String
  requestedAmount     Decimal              @db.Decimal(15, 2)
  requestPurpose      String
  status              FundRequestStatus    @default(PENDING)
  requestedBy         String
  approvedBy          String?
  approvedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime             @default(now())
  source              FundRequestSource    @default(STRUCTURED)
  rejectedBy          String?
  rejectedAt          DateTime?
  approvedByUser      User?                @relation("FundRequestApprovedBy", fields: [approvedBy], references: [id])
  purchaseOrderLine   PurchaseOrderLine    @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  rejectedByUser      User?                @relation("FundRequestRejectedBy", fields: [rejectedBy], references: [id])
  requestedByUser     User                 @relation("FundRequestRequestedBy", fields: [requestedBy], references: [id])
  fundRequestsHistory FundRequestHistory[]
  notifications       Notification[]

  @@index([purchaseOrderLineId])
  @@index([status])
  @@index([requestedBy])
  @@index([status, createdAt(sort: Desc)])
  @@index([requestedBy, createdAt(sort: Desc)])
}

model FundRequestHistory {
  id                       String            @id @default(cuid())
  fundRequestId            String
  purchaseOrderLineId      String
  requestedBy              String
  requestedAmount          Decimal           @db.Decimal(15, 2)
  requestPurpose           String
  status                   FundRequestStatus
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  snapshotContractAmount   Decimal           @db.Decimal(15, 2)
  snapshotRemainingBalance Decimal           @db.Decimal(15, 2)
  snapshotTotalApproved    Decimal           @db.Decimal(15, 2)
  snapshotTotalRejected    Decimal           @db.Decimal(15, 2)
  fundRequest              FundRequest       @relation(fields: [fundRequestId], references: [id], onDelete: Cascade)
  purchaseOrderLine        PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  user                     User              @relation(fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([fundRequestId])
  @@index([purchaseOrderLineId])
  @@index([requestedBy])
}

model ContractAmendment {
  id                  String            @id @default(uuid())
  purchaseOrderLineId String
  oldAmount           Decimal           @db.Decimal(15, 2)
  newAmount           Decimal           @db.Decimal(15, 2)
  reason              String
  approvedBy          String
  createdAt           DateTime          @default(now())
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderLineId])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  fundRequestId String?
  type          NotificationType
  payload       Json
  sentAt        DateTime?
  createdAt     DateTime         @default(now())
  readAt        DateTime?
  fundRequest   FundRequest?     @relation(fields: [fundRequestId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id])

  @@index([fundRequestId])
  @@index([sentAt])
  @@index([readAt])
  @@index([createdAt])
  @@index([userId])
  @@index([type])
}

model FailedNotification {
  id             String           @id @default(cuid())
  notificationId String
  userId         String
  type           NotificationType
  payload        Json
  error          String
  createdAt      DateTime         @default(now())
}

enum AuthRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PoAgingFlag {
  GREEN
  WARNING
  RED
}

enum PoLineStatus {
  NOT_INVOICED
  INVOICED
}

enum FundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FundRequestSource {
  STRUCTURED
  MANUAL
}

enum NotificationType {
  FUND_REQUEST_CREATED
  FUND_REQUEST_APPROVED
  FUND_REQUEST_REJECTED
  CONTRACT_AMENDED
  PO_AGING_WARNING
  ACCOUNT_CREATED
  PASSWORD_RESET
  PASSWORD_CHANGED
  PO_AGING_ALERT
}
